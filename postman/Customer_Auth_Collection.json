{
  "info": {
    "name": "Customer Auth - Onebrik",
    "description": "Customer auth: signup (OTP flow), login (password or OTP), profile, refresh token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://onebrik-node.onrender.com" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "signupToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. New Customer (Signup)",
      "item": [
        {
          "name": "Send OTP - Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"purpose\": \"signup\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/send-otp",
            "description": "Step 1: Request OTP for new signup. Email must not be registered yet."
          }
        },
        {
          "name": "Verify OTP - Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"otp\": \"123456\",\n  \"purpose\": \"signup\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/verify-otp",
            "description": "Step 2: Verify OTP. Returns signupToken. Copy signupToken to collection variable for next request."
          }
        },
        {
          "name": "Complete Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signupToken\": \"{{signupToken}}\",\n  \"name\": \"Jane Doe\",\n  \"password\": \"securePass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/signup",
            "description": "Step 3: Create account with name and password. Use signupToken from Verify OTP - Signup. Returns accessToken and refreshToken."
          }
        }
      ]
    },
    {
      "name": "2. Existing Customer (Login)",
      "description": "Use Password Login or OTP flow (Send OTP → Verify OTP).",
      "item": [
        {
          "name": "Password Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"existing@example.com\",\n  \"password\": \"securePass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/login",
            "description": "Login with email + password (customer only). Returns accessToken and refreshToken. Save accessToken and refreshToken to collection variables."
          }
        },
        {
          "name": "Send OTP - Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"existing@example.com\",\n  \"purpose\": \"login\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/send-otp",
            "description": "Step 1: Request OTP for login. Email must already be registered."
          }
        },
        {
          "name": "Verify OTP - Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"existing@example.com\",\n  \"otp\": \"654321\",\n  \"purpose\": \"login\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/verify-otp",
            "description": "Step 2: Verify OTP and get accessToken + refreshToken. Copy to collection variables for profile requests."
          }
        },
        {
          "name": "Verify OTP Login (Legacy)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"existing@example.com\",\n  \"otp\": \"654321\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/verify-otp-login",
            "description": "Same as Verify OTP with purpose=login. No purpose in body."
          }
        }
      ]
    },
    {
      "name": "3. Token",
      "item": [
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refreshToken",
            "description": "Get new accessToken using refreshToken. Use when access token expires."
          }
        }
      ]
    },
    {
      "name": "4. Customer Profile (JWT required)",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/customer/profile",
            "description": "Get current customer profile. Requires valid accessToken."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"avatarId\": \"totoro\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/profile",
            "description": "Update name and/or avatar. avatarId: totoro, chihiro, ponyo, sophie, howl, kiki, san, ashitaka, no-face, haku. Or use avatarUrl for custom image URL."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"securePass123\",\n  \"newPassword\": \"newSecurePass456\"\n}"
            },
            "url": "{{baseUrl}}/auth/customer/change-password",
            "description": "Change password for logged-in customer. Requires current password and new password (min 6 chars). JWT required."
          }
        },
        {
          "name": "Get Ghibli Avatars",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/customer/avatars",
            "description": "List of Ghibli-style avatars (id, name, url) for profile. Public, no auth."
          }
        }
      ]
    }
  ]
}
