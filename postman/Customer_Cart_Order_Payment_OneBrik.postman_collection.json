{
  "info": {
    "name": "OneBrik - Customer Full Flow",
    "description": "Full flow: Auth (OTP) → Device → Cart (guest) → Login → Address → Order (COD or Razorpay). Variables chain automatically via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "deviceId", "value": "" },
    { "key": "cartId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "razorpayOrderId", "value": "" },
    { "key": "wishlistId", "value": "" },
    { "key": "wishlistItemId", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Customer Auth",
      "description": "OTP-based login. Send OTP → Verify OTP → get accessToken + refreshToken.",
      "item": [
        {
          "name": "Send OTP (Login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}"
            },
            "url": "{{base_url}}/customer-auth/login",
            "description": "Public. Sends a 6-digit OTP to the email. No JWT needed."
          }
        },
        {
          "name": "Verify OTP → Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "}",
                  "if (json.data && json.data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_url}}/customer-auth/verify",
            "description": "Public. Returns accessToken (7m) + refreshToken (7d). Saves both to collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "}",
                  "if (json.data && json.data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{base_url}}/customer-auth/refresh",
            "description": "Public. Use when accessToken expires. Saves new tokens."
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer-auth/profile",
            "description": "JWT required. Returns id, customerId, email, name, mobileNumber, profilePicture."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "John Doe", "type": "text" },
                { "key": "mobileNumber", "value": "9876543210", "type": "text" },
                { "key": "image", "type": "file", "src": "", "description": "Optional profile image" }
              ]
            },
            "url": "{{base_url}}/customer-auth/profile",
            "description": "JWT required. Multipart form. All fields optional. Image uploaded to S3."
          }
        }
      ]
    },
    {
      "name": "1 - Device",
      "description": "Create a device to track guest cart. No JWT needed.",
      "item": [
        {
          "name": "Create Device → Save deviceId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('deviceId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceToken\": \"device-token-abc123\",\n  \"deviceType\": \"web\"\n}"
            },
            "url": "{{base_url}}/customer/device/create",
            "description": "Public. Returns device._id — saved as deviceId. If device already exists, returns existing."
          }
        }
      ]
    },
    {
      "name": "2 - Cart (Guest, no JWT)",
      "description": "Browse products, get/create cart by deviceId, add/update/remove items. No JWT required.",
      "item": [
        {
          "name": "Get Products → Save productId + variantId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var items = json.data && json.data.items;",
                  "if (items && items.length > 0) {",
                  "  var first = items[0];",
                  "  pm.collectionVariables.set('productId', String(first.id || first._id));",
                  "  if (first.variants && first.variants.length > 0) {",
                  "    pm.collectionVariables.set('variantId', String(first.variants[0]._id));",
                  "  } else {",
                  "    pm.collectionVariables.set('variantId', '');",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/items?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["customer", "items"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Public. Returns products with variants. Script saves productId and first variantId."
          }
        },
        {
          "name": "Get Cart → Save cartId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.cart && json.data.cart._id) {",
                  "  pm.collectionVariables.set('cartId', json.data.cart._id);",
                  "}",
                  "if (json.data && json.data.items && json.data.items[0]) {",
                  "  pm.collectionVariables.set('cartItemId', json.data.items[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/cart?deviceId={{deviceId}}",
              "host": ["{{base_url}}"],
              "path": ["customer", "cart"],
              "query": [{ "key": "deviceId", "value": "{{deviceId}}" }]
            },
            "description": "Public. Auto-creates cart if none exists. Saves cartId. Also works with JWT to link guest cart."
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 2\n}"
            },
            "url": "{{base_url}}/customer/cart/{{cartId}}/items",
            "description": "Public. Price is fetched from DB — not from client. variantId is optional. Same product+variant increments quantity."
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": "{{base_url}}/customer/cart/items/{{cartItemId}}",
            "description": "Public. Only quantity can be updated. Price is recalculated from DB price."
          }
        },
        {
          "name": "Delete Cart Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/customer/cart/items/{{cartItemId}}",
            "description": "Public. Soft-deletes item and recalculates cart totals."
          }
        }
      ]
    },
    {
      "name": "3 - Wishlist (Guest + JWT)",
      "description": "Same pattern as Cart. Guest by deviceId (no JWT). Logged-in by JWT. Passing deviceId with JWT merges guest wishlist into customer wishlist.",
      "item": [
        {
          "name": "Get Wishlist (Guest) → Save wishlistId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.wishlist && json.data.wishlist._id) {",
                  "  pm.collectionVariables.set('wishlistId', json.data.wishlist._id);",
                  "}",
                  "if (json.data && json.data.items && json.data.items[0]) {",
                  "  pm.collectionVariables.set('wishlistItemId', json.data.items[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/wishlist?deviceId={{deviceId}}",
              "host": ["{{base_url}}"],
              "path": ["customer", "wishlist"],
              "query": [{ "key": "deviceId", "value": "{{deviceId}}" }]
            },
            "description": "No JWT. Auto-creates wishlist if none exists. Saves wishlistId."
          }
        },
        {
          "name": "Get Wishlist (Logged-in, links guest) → Save wishlistId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.wishlist && json.data.wishlist._id) {",
                  "  pm.collectionVariables.set('wishlistId', json.data.wishlist._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/customer/wishlist?deviceId={{deviceId}}",
              "host": ["{{base_url}}"],
              "path": ["customer", "wishlist"],
              "query": [{ "key": "deviceId", "value": "{{deviceId}}" }]
            },
            "description": "JWT + deviceId → merges guest wishlist into customer wishlist. Saves wishlistId."
          }
        },
        {
          "name": "Get My Wishlist (JWT only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.wishlist && json.data.wishlist._id) {",
                  "  pm.collectionVariables.set('wishlistId', json.data.wishlist._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/wishlist/me",
            "description": "JWT required. No deviceId needed. Returns customer wishlist with items + variant images."
          }
        },
        {
          "name": "Add Item to Wishlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('wishlistItemId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"variantId\": \"{{variantId}}\"\n}"
            },
            "url": "{{base_url}}/customer/wishlist/{{wishlistId}}/items",
            "description": "No JWT. Uses wishlistId from Get Wishlist. variantId is optional. Duplicate is ignored (idempotent). Saves wishlistItemId."
          }
        },
        {
          "name": "Remove Item from Wishlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/customer/wishlist/items/{{wishlistItemId}}",
            "description": "No JWT. Soft-deletes the item and updates totalItems count."
          }
        },
        {
          "name": "Clear Wishlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/customer/wishlist/{{wishlistId}}/clear",
            "description": "No JWT. Soft-deletes all items in the wishlist."
          }
        }
      ]
    },
    {
      "name": "4 - Address (JWT required)",
      "description": "JWT required. Pass deviceId in body/query to link guest cart to logged-in customer.",
      "item": [
        {
          "name": "Create Address → Save addressId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('addressId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressType\": \"home\",\n  \"fullName\": \"John Doe\",\n  \"mobileNumber\": \"9876543210\",\n  \"addressLine1\": \"123 Main Street\",\n  \"addressLine2\": \"Near Park\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"postalCode\": \"400001\",\n  \"country\": \"India\",\n  \"landmark\": \"Near Bus Stop\",\n  \"isDefault\": true,\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": "{{base_url}}/customer/address",
            "description": "deviceId in body links guest cart to customer. Saves addressId."
          }
        },
        {
          "name": "Get Addresses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data[0] && json.data[0]._id) {",
                  "  pm.collectionVariables.set('addressId', json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/address",
            "description": "Returns all addresses for logged-in customer. Saves first addressId."
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressLine1\": \"456 New Street\",\n  \"city\": \"Pune\",\n  \"postalCode\": \"411001\"\n}"
            },
            "url": "{{base_url}}/customer/address/{{addressId}}"
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/address/{{addressId}}"
          }
        }
      ]
    },
    {
      "name": "4A - COD Order (JWT required)",
      "description": "Cash on Delivery. Single API call — order confirmed + payment PENDING (collected on delivery). Stock is reduced. Cart is deactivated.",
      "item": [
        {
          "name": "Place COD Order → Save orderId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.order && json.data.order._id) {",
                  "  pm.collectionVariables.set('orderId', json.data.order._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"shippingCharges\": 50,\n  \"discountAmount\": 0,\n  \"notes\": \"Please call before delivery\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": "{{base_url}}/customer/order/cod",
            "description": "Creates Order (status: confirmed, paymentMethod: cod) + Payment (status: PENDING) in one DB transaction. Stock reduced. Cart deactivated. Saves orderId."
          }
        },
        {
          "name": "Get COD Order Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/order/{{orderId}}",
            "description": "Verify: orderStatus=confirmed, paymentMethod=cod, paymentStatus=PENDING."
          }
        }
      ]
    },
    {
      "name": "4B - Razorpay Order (JWT required)",
      "description": "Online payment via Razorpay. Flow: Create Order → Create Razorpay Order → (client pays on Razorpay) → Verify Payment.",
      "item": [
        {
          "name": "Step 1 - Create Order → Save orderId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.order && json.data.order._id) {",
                  "  pm.collectionVariables.set('orderId', json.data.order._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"shippingCharges\": 50,\n  \"discountAmount\": 0,\n  \"notes\": \"\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": "{{base_url}}/customer/order",
            "description": "Creates order with status: pending. Cart deactivated. Saves orderId."
          }
        },
        {
          "name": "Step 2 - Create Razorpay Order → Save razorpayOrderId + paymentId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('paymentId', json.data.paymentId || '');",
                  "  pm.collectionVariables.set('razorpayOrderId', json.data.razorpayOrderId || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": "{{base_url}}/customer/payment/razorpay/create-order",
            "description": "Returns razorpayOrderId, key, amount (paise), paymentId. Use key + razorpayOrderId in Razorpay Checkout on frontend."
          }
        },
        {
          "name": "Step 3 - Verify Razorpay Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"pay_XXXXXXXXXXXXXXXX\",\n  \"razorpaySignature\": \"signature_from_razorpay_checkout\"\n}"
            },
            "url": "{{base_url}}/customer/payment/razorpay/verify",
            "description": "Call after Razorpay Checkout success. Frontend gets razorpay_order_id, razorpay_payment_id, razorpay_signature from the success handler. Updates payment → SUCCESS, order → confirmed."
          }
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/payment/status/{{paymentId}}",
            "description": "Returns PENDING | SUCCESS | FAILED with amount, transactionId, paymentDate."
          }
        }
      ]
    },
    {
      "name": "5 - Order History",
      "description": "View orders after placement.",
      "item": [
        {
          "name": "Get Order History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/customer/order/history?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["customer", "order", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Returns paginated order list with items."
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/order/{{orderId}}",
            "description": "Returns order + items + paymentStatus, paymentGateway, transactionId, paymentDate."
          }
        },
        {
          "name": "Get My Cart (logged in)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/customer/cart/me",
            "description": "Returns current active cart for logged-in customer."
          }
        }
      ]
    }
  ]
}
