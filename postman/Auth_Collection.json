{
  "info": {
    "name": "Auth APIs - Onebrik",
    "description": "Authentication and customer profile endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "signupToken", "value": "" },
    { "key": "email", "value": "user@example.com" },
    { "key": "password", "value": "securePass123" }
  ],
  "item": [
    {
      "name": "Admin & User",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"securePass123\",\n  \"name\": \"Jane Doe\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/userRegister","host": ["{{baseUrl}}"],"path": ["auth","userRegister"]}
          }
        },
        {
          "name": "Admin Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"adminPass123\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/adminRegistration","host": ["{{baseUrl}}"],"path": ["auth","adminRegistration"]}
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"adminPass123\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/adminLogin","host": ["{{baseUrl}}"],"path": ["auth","adminLogin"]}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/login","host": ["{{baseUrl}}"],"path": ["auth","login"]}
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/refreshToken","host": ["{{baseUrl}}"],"path": ["auth","refreshToken"]}
          }
        }
      ]
    },
    {
      "name": "Customer Auth",
      "item": [
        {
          "name": "Customer Password Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": {{email}},\n  \"password\": {{password}}\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/login","host": ["{{baseUrl}}"],"path": ["auth","customer","login"]}
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": \"{{email}}\",\n  \"purpose\": \"signup\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/send-otp","host": ["{{baseUrl}}"],"path": ["auth","customer","send-otp"]}
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"123456\",\n  \"purpose\": \"signup\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/verify-otp","host": ["{{baseUrl}}"],"path": ["auth","customer","verify-otp"]}
          }
        },
        {
          "name": "Customer Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"signupToken\": \"{{signupToken}}\",\n  \"name\": \"Jane Doe\",\n  \"password\": \"securePass123\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/signup","host": ["{{baseUrl}}"],"path": ["auth","customer","signup"]}
          }
        },
        {
          "name": "Verify OTP Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode": "raw","raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"123456\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/verify-otp-login","host": ["{{baseUrl}}"],"path": ["auth","customer","verify-otp-login"]}
          }
        }
      ]
    },
    {
      "name": "Customer Profile",
      "item": [
        {
          "name": "Get Avatars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/auth/customer/avatars","host": ["{{baseUrl}}"],"path": ["auth","customer","avatars"]}
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {"raw": "{{baseUrl}}/auth/customer/profile","host": ["{{baseUrl}}"],"path": ["auth","customer","profile"]}
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {"mode": "raw","raw": "{\n  \"name\": \"Jane Doe\",\n  \"avatarId\": \"ghibli123\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/profile","host": ["{{baseUrl}}"],"path": ["auth","customer","profile"]}
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {"mode": "raw","raw": "{\n  \"oldPassword\": \"oldPass123\",\n  \"newPassword\": \"newPass456\"\n}"},
            "url": {"raw": "{{baseUrl}}/auth/customer/change-password","host": ["{{baseUrl}}"],"path": ["auth","customer","change-password"]}
          }
        }
      ]
    }
  ]
}