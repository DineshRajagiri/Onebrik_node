{
  "info": {
    "name": "Customer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for customer controller endpoints"
  },
  "item": [
    {
      "name": "Get Items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customer/items?limit=10&page=1&search=",
          "host": ["{{baseUrl}}"],
          "path": ["customer","items"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "page", "value": "1" },
            { "key": "search", "value": "" }
          ]
        }
      }
    },
    {
      "name": "Create Device",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"device-123\",\n  \"platform\": \"android\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/customer/device/create", "host": ["{{baseUrl}}"], "path": ["customer","device","create"] }
      }
    },
    {
      "name": "Activate Cart",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"deviceId\": \"device-123\" }" },
        "url": { "raw": "{{baseUrl}}/customer/cart/activate", "host": ["{{baseUrl}}"], "path": ["customer","cart","activate"] }
      }
    },
    {
      "name": "Get Cart",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/customer/cart?deviceId=device-123", "host": ["{{baseUrl}}"], "path": ["customer","cart"], "query": [{ "key": "deviceId", "value": "device-123" }] }
      }
    },
    {
      "name": "Add Cart Item",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"productId\": \"prod-1\",\n  \"quantity\": 2\n}" },
        "url": { "raw": "{{baseUrl}}/customer/cart/:cartId/items", "host": ["{{baseUrl}}"], "path": ["customer","cart",":cartId","items"] }
      }
    },
    {
      "name": "Update Cart Item",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" },
        "url": { "raw": "{{baseUrl}}/customer/cart/items/:itemId", "host": ["{{baseUrl}}"], "path": ["customer","cart","items",":itemId"] }
      }
    },
    {
      "name": "Delete Cart Item",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/customer/cart/items/:itemId", "host": ["{{baseUrl}}"], "path": ["customer","cart","items",":itemId"] }
      }
    },
    {
      "name": "Create Address",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"line1\": \"123 Main St\",\n  \"city\": \"City\",\n  \"postalCode\": \"12345\"\n}" },
        "url": { "raw": "{{baseUrl}}/customer/address", "host": ["{{baseUrl}}"], "path": ["customer","address"] }
      }
    },
    {
      "name": "Get Addresses",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/customer/address", "host": ["{{baseUrl}}"], "path": ["customer","address"] }
      }
    },
    {
      "name": "Update Address",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"line1\": \"456 New St\"\n}" },
        "url": { "raw": "{{baseUrl}}/customer/address/:addressId", "host": ["{{baseUrl}}"], "path": ["customer","address",":addressId"] }
      }
    },
    {
      "name": "Delete Address",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/customer/address/:addressId", "host": ["{{baseUrl}}"], "path": ["customer","address",":addressId"] }
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"cartId\": \"cart-1\",\n  \"paymentMethod\": \"card\"\n}" },
        "url": { "raw": "{{baseUrl}}/customer/order", "host": ["{{baseUrl}}"], "path": ["customer","order"] }
      }
    },
    {
      "name": "Get Order History",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/customer/order/history?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["customer","order","history"], "query": [{ "key": "page", "value": "1" },{ "key": "limit", "value": "10" }] }
      }
    },
    {
      "name": "Get Order By Id",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/customer/order/:orderId", "host": ["{{baseUrl}}"], "path": ["customer","order",":orderId"] }
      }
    },
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"order-1\",\n  \"amount\": 10000\n}" },
        "url": { "raw": "{{baseUrl}}/customer/payment", "host": ["{{baseUrl}}"], "path": ["customer","payment"] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ]
}